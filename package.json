{
  "name": "neptechnews-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "automation/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "analyze:web": "npm run analyze -w apps/web",
    "analyze:turbo:web": "npm run analyze:turbo -w apps/web"
  }
}
